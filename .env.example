# ---- Privy (login + embedded wallet) ----
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the JWT verification key from the Privy dashboard. When set, logins
# are verified locally instead of over the network. It must be the full PEM with
# real line breaks and no surrounding quotes -- a mangled value makes every
# request fail with 401. Leaving it blank is the safe default.
PRIVY_JWT_VERIFICATION_KEY=

# ---- Gas sponsorship (no env vars needed) ----
# Gas-free transfers use Privy native smart wallets. The bundler + paymaster
# URLs come from your ERC-4337 provider (currently Pimlico) and are entered in
# the Privy dashboard under Smart wallets -> Monad (custom chain), never here.
# See README "Gas-free transfers setup".

# ---- Monad chain ----
NEXT_PUBLIC_MONAD_CHAIN_ID=143
# TODO: confirm the current public/production RPC endpoint in https://docs.monad.xyz
# before deploying -- do not hardcode a guessed URL.
NEXT_PUBLIC_MONAD_RPC_URL=
# Optional, server-only: an RPC URL for the API routes (verifying payments,
# escrow claims, the reconcile job). Set it when your RPC URL contains an API
# key -- anything NEXT_PUBLIC_ is shipped to every browser. Falls back to
# NEXT_PUBLIC_MONAD_RPC_URL.
MONAD_RPC_URL=
NEXT_PUBLIC_MONAD_EXPLORER_URL=

# Native, Circle-issued USDC on Monad mainnet. Copy the address from Circle's
# official USDC contract-address list (developers.circle.com) -- do not use a
# bridged/wrapped token, and don't trust an address copied from anywhere else.
NEXT_PUBLIC_USDC_ADDRESS=

# Deploy contracts/src/TipVault.sol first, then paste its address here.
TIPVAULT_CONTRACT_ADDRESS=
# Who signs TipVault.claim() (releasing escrow after a verified channel link)
# -- it must be the TipVault owner. Preferred: a Privy server wallet whose
# policy allows only TipVault.claim, so the key never lives in this app (see
# README "Escrow claim signer"). Set its wallet ID, and the wallet's
# authorization private key if it has an owner -- paste it exactly as Privy
# shows it, "wallet-auth:" prefix included.
PRIVY_CLAIM_WALLET_ID=
PRIVY_CLAIM_AUTHORIZATION_KEY=
# Fallback when PRIVY_CLAIM_WALLET_ID is empty: the owner's raw private key.
# Server-side only; set it for Production only in your hosting env.
TIPVAULT_OWNER_PRIVATE_KEY=

# Background reconcile job (GET /api/cron/reconcile, see README "Background job").
# Required: at least 16 random characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=
# Optional: blocks per log query (lower it if the RPC rejects the range) and
# blocks scanned per run.
RECONCILE_LOG_RANGE=100
RECONCILE_MAX_BLOCKS=2000

# Address that receives dripp's 1% withdrawal fee (collected in the same
# onchain operation as each payout -- see lib/withdraw-plan.ts).
TREASURY_ADDRESS=

# Stand-in for the offramp: Google account emails (comma-separated) that may
# withdraw to a wallet address. "*" allows everyone; empty turns it off and
# the Withdraw button stays "open soon". See lib/withdraw-access.ts.
WITHDRAW_TO_ADDRESS_EMAILS=

# Most phone-verification codes dripp will pay for in one day, across all
# users (each person is also limited to 1 per 5 minutes and 3 a day). Empty
# means 100. See phoneVerifyLimit in lib/rate-limit.ts.
PHONE_VERIFY_DAILY_CAP=

# ---- Onramp / offramp ----
MERCURYO_WIDGET_ID=
MERCURYO_SECRET_KEY=

# ---- Platform linking (Creator Mode) ----
# Google OAuth is reused here for YouTube channel verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

APP_BASE_URL=http://localhost:3000
# Required: at least 32 random characters, e.g. `openssl rand -hex 32`.
# The app refuses to start a platform link while this is empty or a placeholder.
OAUTH_STATE_SECRET=

# ---- Supabase ----
# Only the server talks to Supabase (service-role key); the browser never
# does, so no anon key is needed.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
