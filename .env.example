# ---- Privy (login + embedded wallet) ----
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the JWT verification key from the Privy dashboard. When set, access
# tokens are verified locally instead of fetching Privy's JWKS over the network.
PRIVY_JWT_VERIFICATION_KEY=

# ---- Gas sponsorship (no env vars needed) ----
# Gas-free transfers use Privy native smart wallets. The bundler + paymaster
# URLs (from https://dashboard.zerodev.app, Monad mainnet project) are entered
# in the Privy dashboard under Smart wallets -> Monad (custom chain 143),
# not here. See README "Gas-free transfers setup".

# ---- Monad chain ----
NEXT_PUBLIC_MONAD_CHAIN_ID=143
# TODO: confirm the current public/production RPC endpoint in https://docs.monad.xyz
# before deploying -- do not hardcode a guessed URL.
NEXT_PUBLIC_MONAD_RPC_URL=
NEXT_PUBLIC_MONAD_EXPLORER_URL=

# Native USDC on Monad mainnet (confirmed live, Circle-issued -- see references in
# 02-differentiation.md). Do not swap this for a bridged/wrapped token.
NEXT_PUBLIC_USDC_ADDRESS=0x754704Bc059F8C67012fEd69BC8A327a5aafb603
NEXT_PUBLIC_USDC_DECIMALS=6

# Deploy contracts/src/TipVault.sol first, then paste its address here.
TIPVAULT_CONTRACT_ADDRESS=
# Private key of the backend-controlled address that is allowed to call
# TipVault.claim() after verifying a creator's platform OAuth. Keep this server-side only.
TIPVAULT_OWNER_PRIVATE_KEY=

# Address that receives dripp's 1% withdrawal fee (collected in the same
# onchain operation as each payout -- see lib/withdraw-plan.ts).
TREASURY_ADDRESS=

# ---- Onramp / offramp ----
MERCURYO_WIDGET_ID=
MERCURYO_SECRET_KEY=

# ---- Platform linking (Creator Mode) ----
# Google OAuth is reused here for YouTube channel verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

APP_BASE_URL=http://localhost:3000
# Required: at least 32 random characters, e.g. `openssl rand -hex 32`.
# The app refuses to start a platform link while this is empty or a placeholder.
OAUTH_STATE_SECRET=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
